# Copy this file to .env (and load it with django-environ, python-dotenv,
# or your host's environment settings panel) — never commit real secrets.

DJANGO_SECRET_KEY=change-this-to-a-random-secret-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000

# Seconds without a reading before a device is shown as DISCONNECTED
DEVICE_OFFLINE_SECONDS=30

# How often the dashboard pages poll the API, in milliseconds
FRONTEND_POLL_INTERVAL_MS=3000
